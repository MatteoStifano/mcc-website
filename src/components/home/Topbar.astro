---
import { languages, homePath, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const codes = Object.keys(languages) as Lang[];
---
<div class="topbar">
  <div class="brand">
    <span class="brand-dot" aria-hidden="true">&gt;</span>
    <span class="brand-name">MCC</span>
    <span class="brand-cursor" aria-hidden="true"></span>
    <span class="brand-ver">v1.0</span>
  </div>
  <div class="actions">
    <nav class="lang" aria-label="Language">
      {codes.map((code, i) => (
        <>
          {i > 0 && <span class="sep">/</span>}
          <a
            href={homePath(code)}
            hreflang={code}
            lang={code}
            class:list={{ active: code === lang }}
            aria-current={code === lang ? 'page' : undefined}
          >{languages[code]}</a>
        </>
      ))}
    </nav>
    <button id="theme-toggle" class="theme-btn" aria-label={t('themeToggle')} type="button"></button>
  </div>
</div>
