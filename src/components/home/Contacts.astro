---
import Section from '../Section.astro';
import CmdLink from '../CmdLink.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---
<Section id="contatti" label={t('contactsLabel')}>
  <CmdLink href="https://chat.whatsapp.com/DDgCFzmLZrmKuDu7k1RoE4" variant="wa" block>
    <svg slot="icon" class="cmd-link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/></svg>
    {t('contactsCta')}
  </CmdLink>
  <CmdLink href="https://www.instagram.com/monopoli_coders_club/" variant="ig" block>
    <svg slot="icon" class="cmd-link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="3"/><path d="M16.5 7.5v.01"/></svg>
    {t('contactsInstagram')}
  </CmdLink>
</Section>
