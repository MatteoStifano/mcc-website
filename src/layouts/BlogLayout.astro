---
// Shell for blog pages: no shader, boot screen or custom cursor
import Head from '../components/Head.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  ogType?: 'website' | 'article';
}

const { title, description, lang = 'it', ogType } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang} class="no-boot">
<head>
  <Head title={title} description={description} lang={lang} ogType={ogType}>
    <link rel="stylesheet" href="/assets/css/blog.css">
    <slot name="head" />
  </Head>
</head>
<body class="blog-page">

  <div class="grid-overlay"></div>
  <div class="noise"></div>

  <div class="topbar">
    <a class="brand" href="/" aria-label="Monopoli Coders Club — home">
      <span class="brand-dot" aria-hidden="true">&gt;</span>
      <span class="brand-name">MCC</span>
      <span class="brand-cursor" aria-hidden="true"></span>
    </a>
    <div class="actions">
      <a class="topbar-link" href="/blog/">Blog</a>
      <button id="theme-toggle" class="theme-btn" aria-label="Cambia tema" type="button"></button>
    </div>
  </div>

  <main class="stage blog-stage">
    <slot />
  </main>

  <div class="page-footer">
    <span>Made with</span>
    <span class="heart">♥</span>
    <span>in Monopoli</span>
  </div>

  <script is:inline src="/assets/js/page.js"></script>
</body>
</html>
