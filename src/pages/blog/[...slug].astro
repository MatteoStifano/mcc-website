---
import { render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import CmdLink from '../../components/CmdLink.astro';
import {
  getPublishedPosts, postSlug, formatDate, readingMinutes,
  GITHUB_REPO, CONTRIBUTING_POSTS, type Post,
} from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, author, github, tags, language } = post.data;
const { Content } = await render(post);
---
<BlogLayout title={`${title} · MCC Blog`} description={description} lang={language} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()}>
    <meta property="article:author" content={author}>
  </Fragment>

  <article class="blog-wrap">
    <a class="back-link" href="/blog/">← Blog</a>

    <div class="card section-card post">
      <header class="post-header">
        <div class="post-meta">
          <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
          {` · ${readingMinutes(post)} min`}
          {tags.map((tag) => <> <span class="tag">#{tag}</span></>)}
        </div>
        <h1 class="post-title">{title}</h1>
        <p class="post-lede">{description}</p>
      </header>

      <div class="prose">
        <Content />
      </div>

      <footer class="post-footer">
        <div class="post-author">
          {github && <img src={`https://github.com/${github}.png?size=96`} alt="" width="48" height="48" loading="lazy">}
          <div>
            <div class="post-author-name">{author}</div>
            {github && <a href={`https://github.com/${github}`} target="_blank" rel="noopener">@{github}</a>}
          </div>
        </div>
        <div class="section-actions">
          {post.filePath && <CmdLink href={`${GITHUB_REPO}/blob/main/${post.filePath}`}>Proponi una modifica</CmdLink>}
          <CmdLink href={CONTRIBUTING_POSTS}>Scrivi anche tu un articolo</CmdLink>
        </div>
      </footer>
    </div>
  </article>
</BlogLayout>
